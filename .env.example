# ---------- Database (PostgreSQL) ----------
# Local: `npm run db:local` starts an embedded PostgreSQL on port 5433 (no Docker needed).
# Production (Neon): DATABASE_URL = pooled connection string (host contains "-pooler", add &pgbouncer=true)
#                    DIRECT_URL   = direct (non-pooled) connection string, used for migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/attendance_local
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/attendance_local
# Used by the API integration tests (separate database, wiped by tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/attendance_local_test

# ---------- API ----------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in invite / reset-password emails)
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API directly (the web app is normally same-origin via proxy)
CORS_ORIGINS=http://localhost:5173
# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-chars-long
JOB_SECRET=change-me-dev-only-job-secret
# Shared secret between the Cloudflare Pages proxy and the API (lets the API trust the real client IP)
PROXY_SECRET=
LOG_LEVEL=info

# ---------- Email (Brevo or Resend HTTP API; "console" just logs emails) ----------
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Attendance Portal <no-reply@example.com>

# ---------- Location names (reverse geocoding) ----------
# nominatim = free OpenStreetMap service (no key; max 1 lookup/second, results cached; set a contact email)
# locationiq / geoapify = free tiers with an API key, for higher volumes · none = store coordinates only
GEOCODER=nominatim
GEOCODER_API_KEY=
GEOCODER_CONTACT_EMAIL=

# ---------- Monitoring (optional) ----------
SENTRY_DSN=

# ---------- Seed ----------
SEED_COMPANY_NAME=Acme Corp
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true
